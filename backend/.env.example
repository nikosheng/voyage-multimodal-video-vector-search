# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=wish_in_motion

# Voyage AI
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-multimodal-3.5
# Optional: override the Voyage API endpoint (e.g. the MongoDB Atlas-hosted
# Voyage endpoint). If unset, the SDK auto-detects the endpoint from the API
# key prefix (al-... -> Atlas endpoint, otherwise -> api.voyageai.com).
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Admin auth
ADMIN_USERNAME=admin
# Generate with scripts/hash_password.py; never store the plaintext password
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=480

# App
TEMP_DIR=/tmp/wish_in_motion
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ffmpeg (optional overrides; defaults to ffmpeg/ffprobe on PATH, which is
# already the case inside the Docker image - see backend/Dockerfile)
# FFMPEG_BINARY_PATH=/path/to/ffmpeg
# FFPROBE_BINARY_PATH=/path/to/ffprobe
